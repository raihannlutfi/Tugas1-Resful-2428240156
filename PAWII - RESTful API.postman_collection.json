        {
          "name": "Semua Area Parkir",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test('Status code adalah 200', function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Data area parkir memiliki struktur yang sesuai', function () {\r\n  const jsonData = pm.response.json();\r\n\r\n  pm.expect(jsonData).to.be.an('array');\r\n\r\n  if (jsonData.length > 0) {\r\n    pm.expect(jsonData[0]).to.have.property('id');\r\n    pm.expect(jsonData[0]).to.have.property('platNomor');\r\n    pm.expect(jsonData[0]).to.have.property('jenisKendaraan');\r\n    pm.expect(jsonData[0]).to.have.property('waktuMasuk');\r\n    pm.expect(jsonData[0]).to.have.property('waktuKeluar');\r\n    pm.expect(jsonData[0]).to.have.property('biaya');\r\n  }\r\n});\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/parking-records",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "parking-records"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Tambah Area Parkir",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test('Status code adalah 201', function () {\r\n  pm.response.to.have.status(201);\r\n});\r\n\r\npm.test('Data parkir memiliki id dan plat nomor sesuai kiriman', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData).to.have.property('id');\r\n  pm.expect(jsonData.platNomor).to.eql('BG 1234 AA');\r\n  pm.expect(jsonData.jenisKendaraan).to.eql('motor');\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n  pm.environment.set('parkingrecordsModelID', pm.response.json().id);\r\n}\r\n\r\n"
                ]
              }
            }
